{
  "name": "mask_api_midwayjs",
  "private": true,
  "version": "0.7.2",
  "description": "🎉 基于 Midwayjs 的管理系统后端接口服务",
  "author": "TsMask",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/TsMask/mask_api_midwayjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./bootstrap.js",
  "scripts": {
    "start:docker": "NODE_ENV=production pm2-runtime start ./bootstrap.js --name mask_api -i 2",
    "start:pm2": "NODE_ENV=production pm2 start ./bootstrap.js --name mask_api -i 2",
    "start": "cross-env NODE_ENV=production node ./bootstrap.js",
    "dev": "cross-env NODE_ENV=local mwtsc --watch --run @midwayjs/mock/app.js",
    "test": "cross-env NODE_ENV=unittest jest",
    "cov": "jest --coverage",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "ci": "npm run cov",
    "build": "mwtsc --cleanOutDir"
  },
  "dependencies": {
    "@midwayjs/bootstrap": "4.2.5",
    "@midwayjs/bullmq": "4.2.5",
    "@midwayjs/busboy": "4.2.5",
    "@midwayjs/core": "4.2.5",
    "@midwayjs/cross-domain": "4.2.5",
    "@midwayjs/koa": "4.2.5",
    "@midwayjs/logger": "4.1.0",
    "@midwayjs/redis": "4.2.5",
    "@midwayjs/security": "4.2.5",
    "@midwayjs/static-file": "4.2.5",
    "@midwayjs/typeorm": "4.2.5",
    "@midwayjs/validation": "4.2.5",
    "@midwayjs/validation-joi": "4.2.5",
    "@node-rs/argon2": "2.2.2",
    "@node-rs/bcrypt": "2.0.0",
    "cron-parser": "5.10.2",
    "dayjs": "1.11.20",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "joi": "18.2.1",
    "jsonwebtoken": "9.0.3",
    "mini-svg-data-uri": "1.4.4",
    "mysql2": "3.22.3",
    "nanoid": "3.3.12",
    "svg-captcha-fixed": "1.5.2",
    "typeorm": "0.3.29",
    "ua-parser-js": "2.0.9"
  },
  "devDependencies": {
    "@midwayjs/mock": "4.2.5",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^24.0.0",
    "cross-env": "10.1.0",
    "jest": "30.4.2",
    "mwts": "2.0.4",
    "mwtsc": "1.16.0",
    "ts-jest": "29.4.10",
    "typescript": "6.0.3"
  },
  "midway-bin-clean": [
    ".vscode/.tsbuildinfo",
    "dist"
  ]
}
