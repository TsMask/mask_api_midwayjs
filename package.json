{
  "name": "mask_api_midwayjs",
  "private": true,
  "version": "0.4.8",
  "description": "🎉 基于 Midwayjs 的管理系统后端接口服务",
  "author": "TsMask",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/TsMask/mask_api_midwayjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./bootstrap.js",
  "scripts": {
    "start:docker": "NODE_ENV=production pm2-runtime start ./bootstrap.js --name mask_api -i 2",
    "start:pm2": "NODE_ENV=production pm2 start ./bootstrap.js --name mask_api -i 2",
    "start": "NODE_ENV=production node ./bootstrap.js",
    "dev": "cross-env NODE_ENV=local mwtsc --watch --run @midwayjs/mock/app.js",
    "test": "cross-env NODE_ENV=unittest jest",
    "cov": "jest --coverage",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "ci": "npm run cov",
    "build": "mwtsc --cleanOutDir"
  },
  "dependencies": {
    "@dropb/diskinfo": "^3.0.0",
    "@midwayjs/bootstrap": "^3.19.3",
    "@midwayjs/bull": "^3.19.3",
    "@midwayjs/core": "^3.19.0",
    "@midwayjs/cross-domain": "^3.19.3",
    "@midwayjs/jwt": "^3.19.3",
    "@midwayjs/koa": "^3.19.2",
    "@midwayjs/logger": "^3.4.2",
    "@midwayjs/redis": "^3.19.3",
    "@midwayjs/security": "^3.19.3",
    "@midwayjs/static-file": "^3.19.3",
    "@midwayjs/typeorm": "^3.19.2",
    "@midwayjs/upload": "^3.19.3",
    "@midwayjs/validate": "^3.19.2",
    "@node-rs/bcrypt": "^1.10.7",
    "cron-parser": "^4.9.0",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "mini-svg-data-uri": "^1.4.4",
    "mysql2": "^3.12.0",
    "nanoid": "^3.3.8",
    "svg-captcha": "^1.4.0",
    "typeorm": "~0.3.0",
    "ua-parser-js": "^2.0.0",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "@midwayjs/mock": "^3.19.2",
    "@types/jest": "^29.5.14",
    "@types/koa": "^2.15.0",
    "@types/ms": "^0.7.34",
    "@types/node": "^18.0.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mwts": "^1.3.0",
    "mwtsc": "^1.15.1",
    "ts-jest": "^29.2.5",
    "typescript": "~5.1.6"
  },
  "midway-bin-clean": [
    ".vscode/.tsbuildinfo",
    "dist"
  ]
}
