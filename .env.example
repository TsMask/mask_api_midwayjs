# 服务端口
PORT=6275

# JWT 配置
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=25
JWT_REFRESH_EXPIRES_IN=10080

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your-db-password
DB_DATABASE=mask_api
DB_LOGGING=false

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
